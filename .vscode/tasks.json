{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch audio files and update index",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\audio\\watch-index.ps1"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
